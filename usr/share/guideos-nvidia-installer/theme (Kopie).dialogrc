#
# Fallout RobCo Terminal Theme for dialog
#

# Set aspect-ratio
aspect = 0

# Set separator (for multiple widgets output)
separate_widget = ""

# Set tab-length (for textbox tab-conversion)
tab_len = 0

# Make tab-traversal for checklist, etc., include the list
visit_items = OFF

# Show scrollbar in dialog boxes?
use_scrollbar = ON

# Shadow dialog boxes? This also turns on color
use_shadow = OFF

# Turn color support ON or OFF
use_colors = ON

# Screen color (Hintergrund: Schwarz, Text: Grün)
screen_color = (GREEN,BLACK,OFF)

# Shadow color
shadow_color = (BLACK,BLACK,OFF)

# Dialog box color (Hauptfenster)
dialog_color = (GREEN,BLACK,OFF)

# Dialog box title color (Titel oben: Hellgrün)
title_color = (GREEN,BLACK,ON)

# Dialog box border color (Rahmen: Grün)
border_color = (GREEN,BLACK,OFF)

# Active button color (Fokussierter Button: Hellgrün/Gefüllt)
button_active_color = (BLACK,GREEN,ON)

# Inactive button color
button_inactive_color = (GREEN,BLACK,OFF)

# Active button key color
button_key_active_color = (BLACK,GREEN,ON)

# Inactive button key color
button_key_inactive_color = (GREEN,BLACK,ON)

# Active button label color
button_label_active_color = (BLACK,GREEN,ON)

# Inactive button label color
button_label_inactive_color = (GREEN,BLACK,OFF)

# Input box color
inputbox_color = (GREEN,BLACK,OFF)

# Input box border color
inputbox_border_color = (GREEN,BLACK,OFF)

# Search box color
searchbox_color = (GREEN,BLACK,OFF)

# Search box title color
searchbox_title_color = (GREEN,BLACK,ON)

# Search box border color
searchbox_border_color = (GREEN,BLACK,OFF)

# File position indicator color
position_indicator_color = (GREEN,BLACK,ON)

# Menu box color
menubox_color = (GREEN,BLACK,OFF)

# Menu box border color
menubox_border_color = (GREEN,BLACK,OFF)

# Item color (Standard-Einträge)
item_color = (GREEN,BLACK,OFF)

# Selected item color (Ausgewählter Eintrag: Invertiertes Grün)
item_selected_color = (BLACK,GREEN,ON)

# Tag color
tag_color = (GREEN,BLACK,ON)

# Selected tag color
tag_selected_color = (BLACK,GREEN,ON)

# Tag key color
tag_key_color = (GREEN,BLACK,ON)

# Selected tag key color
tag_key_selected_color = (BLACK,GREEN,ON)

# Check box color
check_color = (GREEN,BLACK,OFF)

# Selected check box color
check_selected_color = (BLACK,GREEN,ON)

# Up arrow color
uarrow_color = (GREEN,BLACK,ON)

# Down arrow color
darrow_color = uarrow_color

# Item help-text color
itemhelp_color = (GREEN,BLACK,OFF)

# Active form text color
form_active_text_color = (BLACK,GREEN,ON)

# Form text color
form_text_color = (GREEN,BLACK,OFF)

# Readonly form item color
form_item_readonly_color = (GREEN,BLACK,OFF)

# Dialog box gauge color (Fortschrittsbalken)
gauge_color = (BLACK,GREEN,ON)

# Border2 colors
border2_color = (GREEN,BLACK,OFF)
inputbox_border2_color = (GREEN,BLACK,OFF)
searchbox_border2_color = (GREEN,BLACK,OFF)
menubox_border2_color = (GREEN,BLACK,OFF)
