#!/bin/bash

# =======================================================================
# Titel       : nvidiarun
# Autor Original-Skript: Nightworker
# Datum       : 2026-11-20
# Beschreibung: GUI zur Installation und Deinstallation des NVIDIA-Treibers
#               inkl. automatischer MOK-Signierung für Secure Boot
#               und nahtloser Integration ins Hauptmenü
# Lizenz      : MIT
# Sprache     : Bash
# =======================================================================

# Theme für dialog festlegen
export DIALOGRC="/usr/share/guideos-nvidia-installer/theme.dialogrc"

#=======================================================================================================
# Variablen festlegen
DriverFolder="/usr/local/bin/Nvidia/"
DEFAULT_VERSION="580.196.07"
VERSION_2="580.178.04"
VERSION_3="580.126.09"
BASE_URL="https://de.download.nvidia.com/XFree86/Linux-x86_64"

INSTALL_SKRIPT="/usr/local/bin/nv-inst.sh"
#=======================================================================================================

# Hilfsfunktion für Dialog-Abbrüche (ESC / Cancel)
check_escape() {
    if [ $1 -eq 1 ] || [ $1 -eq 255 ]; then
        clear
        echo "Vorgang abgebrochen."
        exit 1
    fi
}

# Hilfsfunktion für Root-/Sudo-Befehle (funktioniert mit und ohne PASSWD)
run_as_root() {
    if [[ $EUID -eq 0 ]]; then
        "$@"
    elif [[ -n "$PASSWD" ]]; then
        echo "$PASSWD" | sudo -S "$@"
    else
        sudo "$@"
    fi
}

# Prüfen, ob das Skript integriert aus dem Hauptmenü gestartet wurde
FROM_MENU="false"
if [[ "$1" == "--from-menu" ]]; then
    FROM_MENU="true"
fi

# Prüfen, ob 'dialog' installiert ist, falls nicht, über CLI nachinstallieren
if ! command -v dialog >/dev/null 2>&1; then
    echo "'dialog' wird installiert..."
    run_as_root apt update && run_as_root apt install -y dialog
fi

PASSWD=""
if [[ "$FROM_MENU" != "true" && $EUID -ne 0 ]]; then
    # Passwort via dialog nur abfragen, wenn nicht als root oder aus dem Hauptmenü gestartet
    PASSWD=$(dialog --title "Sudo Passwort eingeben" \
                    --clear \
                    --insecure \
                    --passwordbox "\nBitte gib dein Sudo-Passwort ein:" 21 72 \
                    3>&1 1>&2 2>&3)
    check_escape $?

    if [ -z "$PASSWD" ]; then
        dialog --title "Fehler" --msgbox "Kein Passwort eingegeben. Skript wird beendet." 8 50
        clear
        exit 1
    fi

    # Passwort validieren
    echo "$PASSWD" | sudo -S -v 2>/dev/null
    if [ $? -ne 0 ]; then
        dialog --title "Fehler" --msgbox "Falsches Passwort. Skript wird beendet." 8 50
        clear
        exit 1
    fi

    # Keepalive für Sudo im Hintergrund laufen lassen
    (
        while true; do
            echo "$PASSWD" | sudo -S -v 2>/dev/null
            sleep 60
        done
    ) &
    SUDO_KEEPALIVE_PID=$!
    trap 'kill $SUDO_KEEPALIVE_PID 2>/dev/null; clear' EXIT
else
    trap 'clear' EXIT
fi

# --- CLI-Flag für die automatisierte Deinstallation von außen ---
if [[ "$1" == "--silent-uninstall" ]]; then
    UNINSTALLER="/usr/bin/nvidia-uninstall"
    PKGS=$(dpkg-query -W -f='${Package}\n' | grep -E '^nvidia-|^libnvidia-|^cuda-' || true)

    # 1. Offizieller NVIDIA-Uninstaller
    if [[ -x "$UNINSTALLER" ]]; then
        run_as_root "$UNINSTALLER" --silent || true
    fi

    # 2. Kernel-Module entladen und Pakete entfernen
    if [[ -n "$PKGS" ]]; then
        run_as_root modprobe -r nvidia_drm || true
        run_as_root modprobe -r nvidia_modeset || true
        run_as_root modprobe -r nvidia || true
        run_as_root apt-get purge --autoremove -y $PKGS xserver-xorg-video-nvidia
        run_as_root apt remove --purge -y '^nvidia-.*'
        run_as_root apt autoremove --purge -y
    fi

    # 3. Zusätzliche Komponenten & Dienste aufräumen
    run_as_root rm -rf "$DriverFolder"
    run_as_root rm -f "$INSTALL_SKRIPT"
    run_as_root systemctl disable nv-inst.service 2>/dev/null || true
    run_as_root rm -f /etc/systemd/system/nv-inst.service

    # 4. Nouveau reaktivieren
    run_as_root apt-get install -y xserver-xorg-video-nouveau
    for f in /etc/modprobe.d/*nouveau*.conf; do
        [[ -f "$f" ]] && run_as_root rm -f "$f"
    done
    echo "nouveau" | run_as_root tee /etc/modules-load.d/nouveau.conf > /dev/null
    run_as_root rm -f /etc/modprobe.d/blacklist-nouveau.conf
    run_as_root rm -f /etc/modprobe.d/nvidia-drm.conf

    exit 0
fi

# Installationsablauf als Funktion (damit bei --from-menu direkt gestartet werden kann)
run_installation_flow() {
    # Versuche zuerst mit nvidia-smi
    GPU_MODEL=$(nvidia-smi --query-gpu=name --format=csv,noheader 2>/dev/null)

    # Fallback mit lspci, wenn nvidia-smi nicht verfügbar
    if [ -z "$GPU_MODEL" ]; then
        GPU_MODEL=$(lspci | grep -i nvidia | sed -n 's/.*NVIDIA Corporation \(.*\) (.*/\1/p')
    fi

    # Falls immer noch leer, Abbruch
    if [ -z "$GPU_MODEL" ]; then
        dialog --title "Fehler" --msgbox "Keine NVIDIA-GPU erkannt." 6 40
        clear
        return 1
    fi

    # Prüfen auf vorhandene Treiber
    if command -v nvidia-smi >/dev/null && nvidia-smi >/dev/null 2>&1; then
        dialog --title "NVIDIA Treiber gefunden" --msgbox "Es ist bereits ein NVIDIA-Treiber installiert.\n\nBitte deinstalliere diesen zuerst, bevor du fortfährst." 21 72
        clear
        return 1
    fi

    # Prüfen, ob NVIDIA-Pakete installiert sind
    if dpkg -l | grep -qE "nvidia-driver|nvidia-kernel|nvidia-dkms"; then
        dialog --title "NVIDIA Treiber gefunden" --msgbox "Es sind bereits NVIDIA-Treiberpakete installiert.\n\nBitte deinstalliere diese zuerst, bevor du fortfährst." 21 72
        clear
        return 1
    fi

    # --- Treiberversion wählen oder manuell eingeben ---
    SELECTED_VER=$(dialog --title "NVIDIA Treiberversion" \
                          --clear \
                          --menu "Wähle die gewünschte NVIDIA-Treiberversion oder gib sie manuell ein:" 21 72 5 \
                          "1" "$DEFAULT_VERSION (vom 2026 Oktober 21)" \
                          "2" "$VERSION_2 (vom 2026 August 3)" \
                          "3" "$VERSION_3 (vom 2026 Januar 13)" \
                          "manuell" "Eigene Versionsnummer manuell eingeben" \
                          3>&1 1>&2 2>&3)
    if [ $? -ne 0 ] || [[ -z "$SELECTED_VER" ]]; then
        clear
        return 1
    fi
    clear

    case "$SELECTED_VER" in
        "1") DRIVER_VERSION="$DEFAULT_VERSION" ;;
        "2") DRIVER_VERSION="$VERSION_2" ;;
        "3") DRIVER_VERSION="$VERSION_3" ;;
        "manuell")
            DRIVER_VERSION=$(dialog --title "Manuelle Treiberversion" \
                                    --clear \
                                    --inputbox "\nBitte gib die gewünschte NVIDIA-Treiberversion ein\n(z. B. $DEFAULT_VERSION):" 21 72 "$DEFAULT_VERSION" \
                                    3>&1 1>&2 2>&3)
            if [ $? -ne 0 ] || [[ -z "$DRIVER_VERSION" ]]; then
                clear
                return 1
            fi
            clear
            ;;
    esac

    if [[ -z "$DRIVER_VERSION" || "$DRIVER_VERSION" == "HIER_VERSION_3_EINTRAGEN" ]]; then
        dialog --title "Fehler" --msgbox "Für Auswahl 3 wurde noch keine gültige Versionsnummer hinterlegt." 8 56
        clear
        return 1
    fi

    # URL und Pfade dynamisch aus der gewählten Version zusammensetzen
    URL="${BASE_URL}/${DRIVER_VERSION}/NVIDIA-Linux-x86_64-${DRIVER_VERSION}.run"
    DownloadCommand="wget -P ${DriverFolder} ${URL}"
    FileName=$(basename "$URL")
    NvidiaDriver="${DriverFolder}${FileName}"

    # Info- und Warntext anzeigen
    dialog --title "Nvidia-Treiber Installation" \
           --yes-label "Weiter" \
           --no-label "Abbrechen" \
           --yesno "In diesem PC ist eine $GPU_MODEL verbaut.\n\nDas Installationsskript lädt die Version $FileName direkt von der offiziellen Nvidia-Webseite herunter. Bitte stelle sicher, dass dein PC mit dem Internet verbunden und die Grafikkarte mit dem Treiber kompatibel ist.\n\nAuf älteren Systemen kann die Installation etwas mehr Zeit in Anspruch nehmen.\n\nBitte unterbreche den Vorgang nicht, da dies dazu führen kann, dass der PC anschließend nicht mehr ordnungsgemäß startet." 21 72

    if [ $? -ne 0 ]; then
        clear
        return 1
    fi

    clear

    echo "Kein NVIDIA-Treiber gefunden. Installation wird fortgesetzt"
    #=============================================================================
    # 32-Bit Architektur aktivieren
    if ! dpkg --print-foreign-architectures | grep -qw i386; then
        echo "🔧 Aktiviere i386-Architektur für 32-Bit-Unterstützung..."
        run_as_root dpkg --add-architecture i386
        run_as_root apt update
    else
        echo "✔ i386-Unterstützung ist bereits aktiviert."
    fi

    # Notwendige Pakete installieren
    run_as_root apt install -y dkms pkg-config libglvnd-dev libgl1-mesa-dev libegl1-mesa-dev

    VERZEICHNIS="/usr/lib32"
    if [ ! -d "$VERZEICHNIS" ]; then
        run_as_root mkdir -p "$VERZEICHNIS"
        echo "Verzeichnis wurde erstellt: $VERZEICHNIS"
    else
        echo "Verzeichnis existiert bereits: $VERZEICHNIS"
    fi
    #=============================================================================

    # --- Secure Boot Erkennung ---
    SECUREBOOT="unbekannt"
    if command -v mokutil &>/dev/null; then
        if mokutil --sb-state 2>/dev/null | grep -iq "enabled"; then
            SECUREBOOT="aktiviert"
        else
            SECUREBOOT="deaktiviert"
        fi
    elif [[ -f /sys/firmware/efi/efivars/SecureBoot-* ]]; then
        if hexdump -v -e '/1 "%u"' /sys/firmware/efi/efivars/SecureBoot-* | grep -q 1; then
            SECUREBOOT="aktiviert"
        else
            SECUREBOOT="deaktiviert"
        fi
    fi

    # --- Secure Boot Handling & Wiederverwendung bestehender MOK-Schlüssel ---
    SIGN_ARGS=""
    MOK_NEED_REBOOT="no"
    if [[ "$SECUREBOOT" == "aktiviert" ]]; then
        dialog --title "Secure Boot aktiv" \
            --msgbox "Secure Boot ist auf diesem System AKTIVIERT.\n\nDas Skript prüft nun, ob bereits ein registrierter MOK-Schlüssel vorhanden ist, um die NVIDIA-Treiber zu signieren." 21 72
        clear

        echo "Installiere Tools für Secure Boot Signierung..."
        run_as_root apt-get install -y openssl mokutil

        DKMS_MOK_PRIV="/var/lib/dkms/mok.key"
        DKMS_MOK_PUB="/var/lib/dkms/mok.pub"

        LOCAL_MOK_DIR="${DriverFolder}mok"
        LOCAL_MOK_PRIV="$LOCAL_MOK_DIR/MOK-nvidia.priv"
        LOCAL_MOK_DER="$LOCAL_MOK_DIR/MOK-nvidia.der"
        MOK_CN="Debian NVIDIA MOK Signing Key"

        MOK_READY="no"

        # 1. Prüfen, ob bereits ein DKMS-MOK-Schlüssel vorhanden und registriert ist
        if [[ -s "$DKMS_MOK_PRIV" && -s "$DKMS_MOK_PUB" ]] && run_as_root mokutil --test-key "$DKMS_MOK_PUB" 2>/dev/null | grep -iq "already enrolled"; then
            SIGN_ARGS="--module-signing-secret-key=$DKMS_MOK_PRIV --module-signing-public-key=$DKMS_MOK_PUB"
            MOK_READY="yes"
            dialog --title "Secure Boot MOK" \
                --msgbox "Bestehender DKMS-MOK-Schlüssel erkannt und bereits registriert.\n\nEs wird kein neuer MOK-Schlüssel erzeugt und kein zusätzlicher MOK-Neustart benötigt." 21 72
            clear
        fi

        # 2. Falls nicht über DKMS vorhanden: eigenen lokalen Schlüssel per Fingerprint prüfen
        if [[ "$MOK_READY" == "no" && -s "$LOCAL_MOK_PRIV" && -s "$LOCAL_MOK_DER" ]]; then
            LOCAL_FP=$(openssl x509 -in "$LOCAL_MOK_DER" -inform DER -fingerprint -sha256 -noout 2>/dev/null | sed 's/.*=//' | tr '[:lower:]' '[:upper:]')
            ENROLLED_LIST=$(run_as_root mokutil --list-enrolled 2>/dev/null | tr '[:lower:]' '[:upper:]')

            if [[ -n "$LOCAL_FP" ]] && echo "$ENROLLED_LIST" | grep -q "$LOCAL_FP"; then
                SIGN_ARGS="--module-signing-secret-key=$LOCAL_MOK_PRIV --module-signing-public-key=$LOCAL_MOK_DER"
                MOK_READY="yes"
                dialog --title "Secure Boot MOK" \
                    --msgbox "Bestehender lokaler MOK-Schlüssel erkannt und bereits registriert.\n\nEine erneute Registrierung entfällt." 21 72
                clear
            fi
        fi

        # 3. Nur wenn noch kein registrierter Schlüssel gefunden wurde: neu erstellen & importieren
        if [[ "$MOK_READY" == "no" ]]; then
            run_as_root mkdir -p "$LOCAL_MOK_DIR"

            if [ ! -f "$LOCAL_MOK_PRIV" ]; then
                run_as_root openssl req -new -x509 -newkey rsa:2048 \
                    -keyout "$LOCAL_MOK_PRIV" \
                    -outform DER -out "$LOCAL_MOK_DER" \
                    -nodes -days 36500 \
                    -subj "/CN=${MOK_CN}/"
                run_as_root chmod 600 "$LOCAL_MOK_PRIV"
            fi

            MOK_PASSWD=$(dialog --title "Secure Boot MOK-Passwort" \
                                --clear \
                                --insecure \
                                --passwordbox "\nBitte gib ein Passwort für die MOK-Registrierung ein.\n\nMerke dir dieses Passwort! Du wirst beim nächsten Systemstart im blauen MOK-Manager danach gefragt:" 21 72 \
                                3>&1 1>&2 2>&3)
            check_escape $?
            clear

            if [ -z "$MOK_PASSWD" ]; then
                dialog --title "Fehler" --msgbox "Kein MOK-Passwort eingegeben. Installation abgebrochen." 8 50
                clear
                return 1
            fi

            clear
            echo "Registriere MOK-Zertifikat für Secure Boot..."
            (
                sleep 1
                echo "$MOK_PASSWD"
                sleep 1
                echo "$MOK_PASSWD"
            ) | run_as_root mokutil --import "$LOCAL_MOK_DER"

            MOK_NEED_REBOOT="yes"
            SIGN_ARGS="--module-signing-secret-key=$LOCAL_MOK_PRIV --module-signing-public-key=$LOCAL_MOK_DER"
        fi
    fi
    #=============================================================================

    echo -e "Linux Header werden geladen...\nNouveau wird deaktiviert...\ninitramfs werden aktualisiert..."

    run_as_root apt-get install -y wget

    # Linux-Headers werden installiert
    echo "Linux-Headers werden installiert"
    run_as_root apt-get install -y linux-headers-$(uname -r)

    # Nouveau deaktivieren
    if ! grep -q "blacklist nouveau" /etc/modprobe.d/*.conf 2>/dev/null; then
        run_as_root tee /etc/modprobe.d/blacklist-nouveau.conf > /dev/null <<EOF
blacklist nouveau
options nouveau modeset=0
EOF
        echo "⚠ Nouveau wurde zur Blacklist hinzugefügt"
    else
        echo "✔ Nouveau ist bereits deaktiviert."
    fi

    echo "# Initramfs wird aktualisiert..."
    run_as_root update-initramfs -u
    echo "# Fertig."

    # Liste unterstützter Chips für nvidia-open
    SUPPORTED_CHIPS=("RTX 20" "RTX 30" "RTX 40" "A100" "L4" "T4" "A30" "H100")

    USE_OPEN="no"
    for chip in "${SUPPORTED_CHIPS[@]}"; do
        if echo "$GPU_MODEL" | grep -qi "$chip"; then
            USE_OPEN="yes"
            break
        fi
    done

    if [ "$USE_OPEN" = "yes" ]; then
        dialog --title "Kompatibilität" \
               --msgbox "✅ Die erkannte GPU \"$GPU_MODEL\" ist mit dem Open-Source-Modul kompatibel.\n\nDu kannst nvidia-open verwenden." 21 72
    else
        dialog --title "Nicht kompatibel" \
               --msgbox "⚠️ Die erkannte GPU \"$GPU_MODEL\" ist NICHT mit dem Open-Source-Treiber kompatibel.\n\nBitte verwende den proprietären Treiber (closed)." 21 72
    fi

    # Auswahlmenü für kernel-module-type
    KMOD_TYPE=$(dialog --title "Nvidia Treiber-Modul" \
        --radiolist "Wähle den Typ des Kernel-Moduls für die Installation des Nvidia-Treibers:" 21 72 2 \
        "closed" "Proprietäres Nvidia-Modul verwenden" ON \
        "open" "Open-Source-Modul (für neuere GPUs empfohlen)" OFF \
        3>&1 1>&2 2>&3)

    if [ $? -ne 0 ] || [[ -z "$KMOD_TYPE" ]]; then
        dialog --title "Fehler" \
               --msgbox "Abbruch durch Benutzer. Keine Auswahl getroffen." 21 72
        clear
        return 1
    fi

    clear

    # Installationsbefehl vorbereiten (inkl. Signier-Argumente falls Secure Boot aktiv)
    if [[ "$KMOD_TYPE" == "open" ]]; then
        INSTALL_CMD="sudo bash $NvidiaDriver --install-compat32-libs --compat32-libdir=/usr/lib32 --kernel-module-type=open --install-libglvnd --silent --dkms $SIGN_ARGS"
    else
        INSTALL_CMD="sudo bash $NvidiaDriver --install-compat32-libs --compat32-libdir=/usr/lib32 --install-libglvnd --silent --dkms $SIGN_ARGS"
    fi

    # Sicherstellen, dass das Verzeichnis existiert
    if [ ! -d "$DriverFolder" ]; then
        echo ""
        echo "---------------------------------------------------"
        echo "Erstelle Verzeichnis: $DriverFolder"
        echo "Bitte warten, bis der Download abgeschlossen ist..."
        echo "---------------------------------------------------"
        run_as_root mkdir -p "$DriverFolder"
        echo ""
    fi

    # Download starten
    if [ ! -f "$NvidiaDriver" ]; then
        run_as_root $DownloadCommand
    fi

    # Überprüfen, ob der Download erfolgreich war
    if [ -f "$NvidiaDriver" ]; then
        dialog --title "Erfolg" --msgbox "Download erfolgreich abgeschlossen!\nDer Treiber wurde gespeichert unter: $NvidiaDriver" 21 72
    else
        dialog --title "Fehler" --msgbox "Download fehlgeschlagen!" 21 72
        clear
        return 1
    fi

    clear

    run_as_root chmod +x "$NvidiaDriver"

    SERVICEFILE="/etc/systemd/system/nv-inst.service"
    #=============================================================================
cat << EOI | run_as_root tee /usr/local/bin/nv-inst.sh > /dev/null
#!/bin/bash
set -e
sleep 5

# Theme für dialog festlegen
export DIALOGRC="/usr/share/debian-nvidia-installer/theme.dialogrc"

# Automatisch auf tty3 umschalten
chvt 3 2>/dev/null || true
sleep 1   # kurze Pause für sichere Umschaltung

# Alles nach tty3 loggen
exec > /dev/tty3 2>&1

echo ">>> Starte NVIDIA-Treiber Installation auf tty3 ..."
touch /var/log/nvidia-installer.log 2>/dev/null || true
LOGFILE="/var/log/nvidia-installer.log"
clear

dialog --title "Installation startet" \
       --colors \
       --timeout 10 \
       --msgbox "Je nach Leistung des PCs kann die Installation\netwas länger dauern.\n\Z1Bitte breche den Vorgang nicht ab.\Zn\n\nDer PC wird im Anschluss automatisch neu gestartet." 10 60 || true
clear

# Installer starten (inkl. Modul-Signierung bei Secure Boot)
$INSTALL_CMD

sleep 2

echo "options nvidia-drm modeset=1" | tee /etc/modprobe.d/nvidia-drm.conf > /dev/null

dialog --title "Installation abgeschlossen" \
       --colors \
       --timeout 5 \
       --msgbox "Nvidia Installation abgeschlossen" 10 60 || true
clear

# Grafisches Boot-Target sicherstellen
systemctl set-default graphical.target 2>/dev/null || true

# Wieder zurück auf tty1 wechseln (für Login/Grafikdisplay)
sleep 1
chvt 1 2>/dev/null || true

# Deaktiviere systemd-Dienst
systemctl disable nv-inst.service 2>/dev/null || true
EOI
    #=============================================================================
    run_as_root chmod +x /usr/local/bin/nv-inst.sh
    #=============================================================================
cat << EOU | run_as_root tee "$SERVICEFILE" > /dev/null
[Unit]
Description=Einmalige Nvidia Installation beim Booten ausführen
Before=graphical.target display-manager.service
ConditionPathExists=$NvidiaDriver

[Service]
Type=oneshot
ExecStart=$INSTALL_SKRIPT
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty1
RemainAfterExit=no

[Install]
WantedBy=graphical.target
EOU
    #=============================================================================
    run_as_root systemctl daemon-reexec
    run_as_root systemctl daemon-reload
    run_as_root systemctl enable nv-inst.service

    # Hinweis für Secure Boot vor dem Neustart nur bei neuer MOK-Registrierung anzeigen
    if [[ "$SECUREBOOT" == "aktiviert" && "$MOK_NEED_REBOOT" == "yes" ]]; then
        dialog --title "Wichtiger Hinweis: Secure Boot" \
               --msgbox "Das System wird gleich neu gestartet.\n\nDa ein neuer MOK-Schlüssel registriert wurde, erscheint beim Booten ein blauer Bildschirm (MOK Manager):\n1. Wähle 'Enroll MOK'\n2. Wähle 'Continue' / 'Yes'\n3. Gib das eben erstellte MOK-Passwort ein\n4. Starte den PC danach normal. Die NVIDIA-Installation läuft im Anschluss automatisch durch!" 21 72
    fi

    dialog --title "Abfrage" --yesno "Der PC wird jetzt neu gestartet und der Treiber installiert." 21 72
    if [ $? -eq 0 ]; then
        clear
        run_as_root reboot
    fi
    clear
    return 0
}

# Wenn aus dem Hauptmenü gestartet (--from-menu), direkt den Installationsablauf starten
if [[ "$FROM_MENU" == "true" ]]; then
    run_installation_flow
    exit $?
fi

# Standalone-Hauptmenü (falls nvidiarun direkt ohne Hauptskript aufgerufen wird)
while true; do
    option=$(dialog --title "Nvidia Treiber Installation" \
                    --clear \
                    --menu "Bitte treffen Sie eine Auswahl (Pfeiltasten = Bewegen, Enter = Bestätigen):" 21 72 4 \
                    "1" "Treiber von Nvidia laden und installieren" \
                    "2" "Nvidia Treiber entfernen" \
                    "3" "Den PC neu starten" \
                    "4" "Das Skript beenden" \
                    3>&1 1>&2 2>&3)

    if [ $? -ne 0 ]; then break; fi

    case $option in
    "1")
        run_installation_flow
        ;;

    "2")
        PKGS=$(dpkg-query -W -f='${Package}\n' | grep -E '^nvidia-|^libnvidia-|^cuda-' || true)
        UNINSTALLER="/usr/bin/nvidia-uninstall"

        if [[ -n "$PKGS" || -x "$UNINSTALLER" ]]; then
            LIST_MSG=""
            [[ -n "$PKGS" ]] && LIST_MSG+="\nGefundene Pakete:\n$PKGS"
            [[ -x "$UNINSTALLER" ]] && LIST_MSG+="\nes ist ein offizieller NVIDIA-Uninstaller vorhanden."

            if ! dialog --title "NVIDIA-Treiber gefunden" \
                        --yesno "\nEs wurde ein installierter NVIDIA-Treiber gefunden und ${LIST_MSG}\n\nMöchten Sie diesen Treiber vollständig entfernen?" 21 72; then

                dialog --title "Abbruch" --msgbox "\nDie Deinstallation wurde abgebrochen." 21 72
                clear
                exit 0
            fi
            clear

            if [[ -x "$UNINSTALLER" ]]; then
                dialog --title "Entfernung" --msgbox "\nStarte offiziellen NVIDIA-Uninstaller..." 21 72
                sleep 2
                clear
                run_as_root "$UNINSTALLER" --silent || true
            fi

            if [[ -n "$PKGS" ]]; then
                dialog --title "Entfernung" --infobox "\nEntferne NVIDIA-Pakete..." 21 72
                sleep 2
                clear

                (
                    echo "10"
                    run_as_root modprobe -r nvidia_drm || true
                    run_as_root modprobe -r nvidia_modeset || true
                    run_as_root modprobe -r nvidia || true

                    echo "30"
                    run_as_root apt-get purge --autoremove -y $PKGS xserver-xorg-video-nvidia

                    echo "60"
                    run_as_root apt remove --purge -y '^nvidia-.*'

                    echo "80"
                    run_as_root apt autoremove --purge -y

                    echo "100"
                )
            fi

            run_as_root rm -rf "$DriverFolder"
            run_as_root rm -f "$INSTALL_SKRIPT"
            run_as_root systemctl disable nv-inst.service 2>/dev/null || true
            run_as_root rm -f /etc/systemd/system/nv-inst.service

            run_as_root apt-get install -y xserver-xorg-video-nouveau

            for f in /etc/modprobe.d/*nouveau*.conf; do
                [[ -f "$f" ]] && run_as_root rm -f "$f"
            done

            echo "nouveau" | run_as_root tee /etc/modules-load.d/nouveau.conf > /dev/null
            run_as_root rm -f /etc/modprobe.d/blacklist-nouveau.conf
            run_as_root rm -f /etc/modprobe.d/nvidia-drm.conf

            dialog --title "Fertig" \
                   --msgbox "\nDer NVIDIA-Treiber wurde entfernt und der Nouveau-Treiber aktiviert.\n\nBitte starten Sie das System neu." 21 72
            clear
        else
            dialog --title "Keine Treiber" --msgbox "\nEs wurden keine NVIDIA-Treiber gefunden." 21 72
            clear
        fi
        ;;

    "3")
        dialog --title "Neustart" --yesno "🔁 PC wirklich neu starten?" 21 72
        if [ $? -eq 0 ]; then
            clear
            run_as_root reboot
        fi
        clear
        ;;

    "4")
        dialog --title "Beenden" --msgbox "👋 Das Skript wird beendet." 21 72
        clear
        exit 0
        ;;
    esac
done
